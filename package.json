{
  "name": "@vue-spark/compose-kit",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.11.0",
  "description": "面向复杂业务的组合式 Vue 开发工具包：可复用的 Composables、SFC 组件与通用工具，显著提升开发效率。",
  "author": "leihaohao <https://github.com/l246804>",
  "license": "MIT",
  "homepage": "https://github.com/vue-spark/compose-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vue-spark/compose-kit.git"
  },
  "bugs": {
    "url": "https://github.com/vue-spark/compose-kit/issues"
  },
  "keywords": [
    "web",
    "function",
    "use",
    "hook",
    "composable",
    "ui"
  ],
  "sideEffects": false,
  "exports": {
    "./*": "./src/*/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsx .scripts/build.ts",
    "runtime:dev": "pnpm -C runtime dev",
    "runtime:build": "pnpm -C runtime build",
    "runtime:release": "pnpm -C runtime release",
    "test": "vitest",
    "typecheck": "vue-tsc --build --noEmit",
    "format": "prettier . --write --cache --cache-location ./node_modules/.cache/.prettier-cache",
    "lint": "eslint . --cache --cache-location ./node_modules/.cache/.eslint-cache",
    "lint:fix": "pnpm run lint --fix",
    "release": "bumpp",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "element-plus": "^2.11.5",
    "vue": "^3.5.22",
    "vxe-table": "^4.17.14"
  },
  "peerDependenciesMeta": {
    "element-plus": {
      "optional": true
    },
    "vxe-table": {
      "optional": true
    }
  },
  "dependencies": {
    "@vue-spark/compose-kit-runtime": "workspace:*",
    "type-fest": "^5.1.0",
    "vue-component-type-helpers": "^3.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.0.0",
    "@sxzz/prettier-config": "^2.2.3",
    "@tsconfig/node24": "^24.0.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.16.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^14.0.0",
    "archiver": "^7.0.1",
    "bumpp": "^10.2.0",
    "element-plus": "^2.11.5",
    "eslint": "^9.30.1",
    "eslint-plugin-format": "^1.0.1",
    "happy-dom": "^20.0.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.13.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-raw": "^0.6.3",
    "unplugin-vue": "^7.0.3",
    "unplugin-vue-components": "^30.0.0",
    "unplugin-vue-router": "^0.17.0",
    "vite": "npm:rolldown-vite@^7.1.19",
    "vitest": "^4.0.10",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.2.4",
    "vxe-table": "^4.17.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  }
}
